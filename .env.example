# ─── Base de datos (Neon) ────────────────────────────────────────────
# Runtime de la app: conexión CON pooling (el host contiene "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Migraciones, seed y Prisma Studio: conexión DIRECTA (sin "-pooler")
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Local con Docker (docker compose up -d), en lugar de Neon:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_documental"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gestor_documental"

# ─── Auth.js ─────────────────────────────────────────────────────────
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""
# URL pública de la app (en Vercel se puede omitir)
AUTH_URL="http://localhost:3000"

# ─── Almacenamiento (Cloudflare R2) — se configura en la fase 3 ─────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
