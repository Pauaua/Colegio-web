# Copie este archivo como terraform.tfvars y ajuste los valores.
# La contraseña de la base NO va aquí: export TF_VAR_db_password="<clave-segura>"
# (mínimo 12 caracteres, sin /, @, comillas dobles ni espacios).

aws_region   = "us-east-1"
project_name = "chorombo-bajo"
environment  = "produccion"
owner        = "Escuela Basica G-733 Chorombo Bajo"

# Correo que recibe las alertas (confirme la suscripción que llega por email).
alert_email = "direccion@colegiochorombo.cl"

# Cómputo y autoescalado (valores del documento técnico).
instance_type = "t3.micro"
asg_min       = 2
asg_desired   = 2
asg_max       = 4
cpu_target    = 60

# Base de datos.
db_instance_class      = "db.t3.micro"
db_name                = "gestor_documental"
db_username            = "gestor_admin"
db_multi_az            = true
db_deletion_protection = false
db_skip_final_snapshot = true

# Publicación: sin dominio, CloudFront entrega HTTPS con *.cloudfront.net
# y Route 53 crea la zona privada chorombo.internal.
enable_cloudfront = true
enable_https      = false
domain_name       = ""
hosted_zone_id    = ""

# --- AWS Academy / Learner Lab ---------------------------------------------------
# No permite crear roles IAM: use el instance profile del laboratorio.
# existing_instance_profile = "LabInstanceProfile"
# Si la creación de llaves KMS está restringida, use la llave administrada aws/s3:
# use_custom_kms_key = false
