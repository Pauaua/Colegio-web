# --- Servidor ---
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# En EC2: /var/log/gestor-documental/app.log (lo envía CloudWatch Agent). Vacío = stdout.
LOG_FILE=

# --- Base de datos (local: MySQL 8 de docker-compose; AWS: endpoint de Amazon RDS) ---
DATABASE_URL=mysql://root:root@localhost:3306/gestor_documental

# --- Autenticación ---
# Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio
# Llave para cifrar los secretos MFA en la base (si se omite, se deriva de JWT_SECRET)
MFA_ENCRYPTION_KEY=
# Intentos FALLIDOS de login permitidos por IP cada 15 minutos
LOGIN_RATE_LIMIT_MAX=20

# --- Almacenamiento (local: MinIO; AWS: bucket S3 con credenciales del rol de la instancia) ---
S3_BUCKET=chorombo-documentos-local
AWS_REGION=us-east-1
# Solo en local (MinIO). En AWS se deja vacío.
S3_ENDPOINT=http://localhost:9000
# Endpoint que se usa al firmar URLs para los clientes (p. ej. la IP del PC para Expo Go). Vacío = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# Solo en local (MinIO). En AWS NO se definen: se usa el rol IAM de la instancia.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Web ---
# Orígenes permitidos por CORS, separados por coma (* = cualquiera)
CORS_ORIGINS=*
# Carpeta del build web de la app (por defecto ../app/dist)
WEB_DIST_DIR=
