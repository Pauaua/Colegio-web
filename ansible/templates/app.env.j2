# {{ ansible_managed }}
# Variables de entorno del Gestor Documental (las lee systemd con EnvironmentFile).
NODE_ENV=production
PORT={{ app_port }}
LOG_FILE={{ log_dir }}/app.log

# Amazon RDS MySQL
DATABASE_URL=mysql://{{ db_user }}:{{ db_password | urlencode }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}

# Autenticación (el mismo secreto en todas las instancias detrás del ALB)
JWT_SECRET={{ app_jwt_secret }}

# Amazon S3: credenciales del rol de la instancia (sin access keys)
S3_BUCKET={{ s3_bucket }}
AWS_REGION={{ aws_region }}

# Build web de la app servido por el backend
WEB_DIST_DIR={{ app_dir }}/app/dist
# INSTANCE_ID no se define: la API lo obtiene de los metadatos de la instancia (IMDSv2) para /health.
